{
  "name": "express-starter-mongodb",
  "version": "1.0.0",
  "description": "This the perfect Starter you want for a Nodejs Express app using Typescript and mongodb. This contains proper module based structure to make the code maintainable for longer run.",
  "keywords": [
    "starter-template"
  ],
  "homepage": "https://github.com/codeseker/express-starter#readme",
  "bugs": {
    "url": "https://github.com/codeseker/express-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeseker/express-starter.git"
  },
  "license": "ISC",
  "author": "Ayush",
  "type": "commonjs",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "echo Checking types... && tsc --noEmit && echo Building... && tsc && tsc-alias && echo Done!",
    "start": "node dist/server.js",
    "db:seed": "tsx src/common/database/seeder/seeder.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
