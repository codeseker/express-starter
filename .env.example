# Auth secrets
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY_TIME=

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY_TIME=

# App environment (dev | prod | test)
APP_MODE=

# MongoDB connection URIs
MONGO_DEV_URI=
MONGO_PROD_URI=
MONGO_TEST_URI=

# Database driver
DB_NAME=mongodb

# Seed/admin credentials
ADMIN_USER_PASSWORD=
USER_PASSWORD=

# Frontend origins (for CORS etc.)
FRONTEND_DEV_URI=
FRONTEND_PROD_URI=
FRONTEND_TEST_URI=

# Server port
PORT=

# SMTP / Mailer
# For development you can use Ethereal (https://ethereal.email) or Mailtrap.
# For production use your real SMTP provider (SendGrid, SES, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App Name <no-reply@example.com>"